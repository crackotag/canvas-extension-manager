PORT=3000
MONGODB_URL=mongodb://127.0.0.1:27017/canvas-extension-manager
# Copy Client ID from Canvas LTI Developer Key after creating it
CANVAS_CLIENT_ID=REPLACE_ME
# For Instructure-hosted Canvas, usually https://canvas.instructure.com (LTI issuer)
CANVAS_ISSUER=https://canvas.instructure.com
# Set this to the endpoint appropriate to your Canvas test/beta environment.
CANVAS_AUTH_URL=https://sso.canvaslms.com/api/lti/authorize_redirect
CANVAS_TOKEN_URL=https://canvas.instructure.com/login/oauth2/token
CANVAS_JWKS_URL=https://canvas.instructure.com/api/lti/security/jwks
# HTTPS URL provided by your tunnel; used only in configuring the Canvas key
PUBLIC_BASE_URL=https://YOUR-TUNNEL.example
